#!/usr/bin/env bash
set -euo pipefail

# keymaster-resign: Re-sign the keymaster binary with an Apple Development
# identity so the macOS Keychain "Always Allow" trust survives a rebuild.
# `brew upgrade keymaster` recompiles from source and produces a fresh ad-hoc
# signature (cdhash-based, changes every build), which invalidates the Keychain
# ACL and re-triggers the prompts. Run this once after such a rebuild.
#
# The identity needs a Team ID. Keychain items also check a partition list, and
# code without a Team ID is partitioned by its cdhash, so a self-signed cert
# still re-prompts after every rebuild. See the "Code signing" section of the
# README.

# $KEYMASTER_SIGNING_IDENTITY if set, else the first valid Apple Development
# identity, matched by SHA-1 so a renewed cert sitting next to the old one
# isn't ambiguous.
if [[ -n "${KEYMASTER_SIGNING_IDENTITY:-}" ]]; then
  IDENTITY="$KEYMASTER_SIGNING_IDENTITY"
else
  IDENTITY="$(/usr/bin/security find-identity -v -p codesigning \
    | awk '/"Apple Development: /{print $2; exit}')"
fi

# Resolve keymaster binary: check relative to this script first, then PATH.
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
if [[ -x "$SCRIPT_DIR/keymaster" ]]; then
  KEYMASTER="$SCRIPT_DIR/keymaster"
else
  KEYMASTER="$(command -v keymaster || true)"
fi

if [[ -z "${KEYMASTER:-}" || ! -x "$KEYMASTER" ]]; then
  echo "keymaster-resign: cannot find the keymaster binary" >&2
  exit 1
fi

# Follow symlinks to the real Mach-O file (Homebrew puts a bin symlink on PATH
# pointing into the Cellar; codesign must operate on the actual file).
target="$KEYMASTER"
while [[ -L "$target" ]]; do
  link="$(readlink "$target")"
  if [[ "$link" = /* ]]; then
    target="$link"
  else
    target="$(cd "$(dirname "$target")" && cd "$(dirname "$link")" && pwd)/$(basename "$link")"
  fi
done

if [[ -z "$IDENTITY" ]]; then
  cat >&2 <<EOF
keymaster-resign: no Apple Development code-signing identity found.

Get one from Xcode (see the "Code signing" section of the keymaster README), or
set KEYMASTER_SIGNING_IDENTITY to an existing identity that has a Team ID.
EOF
  exit 1
fi

/usr/bin/codesign -f -s "$IDENTITY" -i keymaster "$target"
echo "keymaster-resign: signed $target with '$IDENTITY'"
